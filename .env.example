# ==============================================================================
# StoreNova: Multi-Tenant E-commerce SaaS Platform Environment Configuration
# ==============================================================================
# ⚠️ निर्देश:
# 1. इस फाइल को कॉपी करके ".env" या ".env.local" नाम से सेव करें।
# 2. केवल "VITE_" से शुरू होने वाले वेरिएबल्स ही ब्राउज़र (Frontend) में लोड होते हैं।
# 3. Service Role Key, Database Passwords और Private Secrets को कभी भी "VITE_" न बनाएं
#    ताकि वे Client-side JavaScript bundle में लीक न हों।
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PLATFORM CONFIGURATION (Vite Client Safe)
# ------------------------------------------------------------------------------
# एप्लिकेशन का नाम
VITE_APP_NAME=StoreNova

# करंट एनवायरनमेंट: development | production | test
VITE_APP_ENV=development

# एप्लिकेशन का बेस URL (लोकल टेस्टिंग या लाइव डोमेन)
# Local: http://localhost:5173
# Production (Hostinger): https://your-domain.com
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & DATABASE (Frontend Public API)
# ------------------------------------------------------------------------------
# प्राप्ति स्रोत:
# 1. Supabase Dashboard (https://supabase.com/dashboard) पर जाएं।
# 2. अपना प्रोजेक्ट चुनें या नया प्रोजेक्ट बनाएं।
# 3. Settings (Gear Icon) -> "API" टैब में जाएं।
# 4. Project URL और Project API Keys ("anon" "public") कॉपी करें।

# आपका Supabase प्रोजेक्ट URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# आपका Supabase Anon (Public) Key - यह Row Level Security (RLS) द्वारा सुरक्षित है
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# मर्चेंट लोगो और प्रोडक्ट इमेजेस के लिए Supabase Storage Bucket नाम
VITE_SUPABASE_STORAGE_BUCKET=storenova-assets

# ------------------------------------------------------------------------------
# 3. PAYMENT OPTIONS & FEATURE TOGGLES
# ------------------------------------------------------------------------------
# मर्चेंट UPI QR कोड पेमेंट फीचर सक्षम/अक्षम करने के लिए (true/false)
VITE_ENABLE_UPI_PAYMENTS=true

# कैश ऑन डिलीवरी (Cash on Delivery - COD) विकल्प सक्षम/अक्षम करने के लिए (true/false)
VITE_ENABLE_COD_PAYMENTS=true

# (वैकल्पिक) SaaS सब्सक्रिप्शन पेमेंट गेटवे (Client-side Public Keys)
# यदि आप SaaS प्लान्स के लिए Razorpay/Stripe जोड़ना चाहें:
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ==============================================================================
# 4. BACKEND / SERVER-ONLY SECRETS (STRICTLY PRIVATE - NEVER USE 'VITE_' PREFIX)
# ==============================================================================
# ⚠️ सुरक्षा चेतावनी:
# नीचे दिए गए वेरिएबल्स केवल Node.js सर्वर, Supabase Edge Functions, या CI/CD पाइपलाइन
# में ही उपयोग होने चाहिए। इन्हें कभी भी Vite frontend कोड में direct import न करें।

# Supabase Service Role Secret Key (यह RLS को बायपास करता है, सुपर-एडमिन ऑपरेशन्स के लिए)
# प्राप्ति: Supabase Dashboard -> Project Settings -> API -> "service_role" (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# PostgreSQL Database Direct Connection String (Migrations / Prisma / Drizzle / Edge Functions)
# प्राप्ति: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connection Pooling URL (Supavisor / PgBouncer - Port 6543)
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true

# (वैकल्पिक) SaaS Recurring Billing Server Secret Keys
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key
